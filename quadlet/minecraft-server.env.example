EULA=true
TYPE=PAPER
DIFFICULTY=normal
MOTD=minecraft server
USE_MEOWICE_FLAGS=true
MEMORY=2G
PLUGINS_FILE=/extras/plugins.txt
MODRINTH_PROJECT=@/extras/modrinth.txt

# The following UID is workaround, this ensure the file generated by server
# has the same ownership. This is caused by weird quirk of subuid and subgid.
# On future implementation we might want to create a dedicated user with
# defined subuid range and remove this workaround altogether
UID=0
GID=0
